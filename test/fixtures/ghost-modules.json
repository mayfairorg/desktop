{
  "_label": "Hand-labelled fixtures for test/ghost-modules*.test.js. Every name, address and number is invented; nothing here is real registry or resolver data. example.com stands for 'the investigated domain'.",
  "routes": [
    { "_label": "IANA DNS bootstrap: .com and .net served by a fixture registry; .org lists an insecure URL first (must be skipped) then an https one", "match": { "host": "data.iana.org", "path": "/rdap/dns.json" },
      "json": { "version": "1.0", "services": [ [["com", "net"], ["https://rdap.registry-fixture.example/"]], [["org"], ["http://insecure.example/", "https://rdap.org-fixture.example/rdap/"]] ] } },
    { "_label": "IANA IPv4 bootstrap: 11.0.0.0/8 and 8.0.0.0/8 are served by one fixture RIR", "match": { "host": "data.iana.org", "path": "/rdap/ipv4.json" },
      "json": { "services": [ [["11.0.0.0/8", "8.0.0.0/8"], ["https://rdap.rir-fixture.example/"]] ] } },
    { "_label": "IANA IPv6 bootstrap: 2a00:1450::/32 served by the fixture RIR", "match": { "host": "data.iana.org", "path": "/rdap/ipv6.json" },
      "json": { "services": [ [["2a00:1450::/32"], ["https://rdap.rir-fixture.example/"]] ] } },
    { "_label": "IANA ASN bootstrap: 64496-64511 and 65000 served by the fixture RIR", "match": { "host": "data.iana.org", "path": "/rdap/asn.json" },
      "json": { "services": [ [["64496-64511", "65000"], ["https://rdap.rir-fixture.example/"]] ] } },

    { "_label": "Registry answer for example.com: registrar org with nested abuse role, a REDACTED registrant, one natural-person technical contact (Jane Fixture-Person) that must never be reported, 3 events, 2 name servers, DNSSEC on",
      "match": { "host": "rdap.registry-fixture.example", "path": "/domain/example.com" },
      "json": { "objectClassName": "domain", "handle": "FIX-123", "ldhName": "EXAMPLE.COM", "status": ["client transfer prohibited", "active"], "secureDNS": { "delegationSigned": true },
        "events": [ { "eventAction": "registration", "eventDate": "1995-08-14T04:00:00Z" }, { "eventAction": "expiration", "eventDate": "2027-08-13T04:00:00Z" }, { "eventAction": "last changed", "eventDate": "2026-08-14T07:01:44Z" } ],
        "nameservers": [ { "ldhName": "NS1.EXAMPLE.COM" }, { "ldhName": "ns2.example.com" } ],
        "entities": [
          { "roles": ["registrar"], "handle": "999", "vcardArray": ["vcard", [["version", {}, "text", "4.0"], ["fn", {}, "text", "Fixture Registrar Inc."]]],
            "entities": [ { "roles": ["abuse"], "vcardArray": ["vcard", [["version", {}, "text", "4.0"], ["fn", {}, "text", "Abuse Contact"], ["email", {}, "text", "abuse@registrar-fixture.example"]]] } ] },
          { "roles": ["registrant"], "vcardArray": ["vcard", [["version", {}, "text", "4.0"], ["fn", {}, "text", "REDACTED FOR PRIVACY"], ["kind", {}, "text", "individual"]]] },
          { "roles": ["technical"], "vcardArray": ["vcard", [["version", {}, "text", "4.0"], ["fn", {}, "text", "Jane Fixture-Person"], ["kind", {}, "text", "individual"], ["email", {}, "text", "jane@person-fixture.example"]]] }
        ] } },
    { "_label": "Registry has no such domain", "match": { "host": "rdap.registry-fixture.example", "path": "/domain/unregistered.com" }, "status": 404, "json": { "errorCode": 404 } },
    { "_label": "Registry for .org answers with something that is not a domain object", "match": { "host": "rdap.org-fixture.example", "pathPrefix": "/rdap/domain/" }, "json": { "objectClassName": "nameserver" } },

    { "_label": "IP network record: 11.22.33.0/24, operator org (kind org) with abuse role, a person contact that must be dropped",
      "match": { "host": "rdap.rir-fixture.example", "pathPrefix": "/ip/" },
      "json": { "objectClassName": "ip network", "handle": "NET-11-22-33-0-1", "startAddress": "11.22.33.0", "endAddress": "11.22.33.255", "ipVersion": "v4", "name": "FIXTURE-NET", "type": "ALLOCATION", "country": "GB",
        "cidr0_cidrs": [ { "v4prefix": "11.22.33.0", "length": 24 } ],
        "events": [ { "eventAction": "registration", "eventDate": "2001-02-03T00:00:00Z" }, { "eventAction": "last changed", "eventDate": "2020-01-01T00:00:00Z" } ],
        "entities": [
          { "roles": ["registrant"], "handle": "ORG-FNO1", "vcardArray": ["vcard", [["fn", {}, "text", "Fixture Network Operations Ltd"], ["kind", {}, "text", "org"]]],
            "entities": [ { "roles": ["abuse"], "vcardArray": ["vcard", [["fn", {}, "text", "Fixture Abuse Desk"], ["email", {}, "text", "abuse@fno-fixture.example"]]] } ] },
          { "roles": ["technical"], "vcardArray": ["vcard", [["fn", {}, "text", "Pat Fixture-Person"], ["kind", {}, "text", "individual"]]] }
        ] } },
    { "_label": "Autonomous system 64500 in the documentation AS range", "match": { "host": "rdap.rir-fixture.example", "path": "/autnum/64500" },
      "json": { "objectClassName": "autnum", "handle": "AS64500", "startAutnum": 64496, "endAutnum": 64511, "name": "FIXTURE-AS", "type": "DIRECT ALLOCATION", "country": "GB",
        "events": [ { "eventAction": "registration", "eventDate": "2010-05-06T00:00:00Z" } ],
        "entities": [ { "roles": ["registrant"], "vcardArray": ["vcard", [["fn", {}, "text", "Fixture Transit plc"], ["org", {}, "text", ["Fixture Transit plc"]]]] } ] } },
    { "_label": "AS number the registry does not know", "match": { "host": "rdap.rir-fixture.example", "path": "/autnum/65000" }, "status": 404, "json": {} },

    { "_label": "DoH A: one address, resolver validated DNSSEC (AD true)", "match": { "host": "cloudflare-dns.com", "path": "/dns-query", "query": { "name": "example.com", "type": "A" } },
      "json": { "Status": 0, "AD": true, "Answer": [ { "name": "example.com.", "type": 1, "TTL": 300, "data": "198.51.100.7" } ] } },
    { "_label": "DoH AAAA: not validated (AD false)", "match": { "host": "cloudflare-dns.com", "path": "/dns-query", "query": { "name": "example.com", "type": "AAAA" } },
      "json": { "Status": 0, "AD": false, "Answer": [ { "name": "example.com.", "type": 28, "TTL": 300, "data": "2001:db8::7" } ] } },
    { "_label": "DoH MX: two exchangers", "match": { "host": "cloudflare-dns.com", "path": "/dns-query", "query": { "name": "example.com", "type": "MX" } },
      "json": { "Status": 0, "AD": true, "Answer": [ { "name": "example.com.", "type": 15, "TTL": 60, "data": "10 mail.example.com." }, { "name": "example.com.", "type": 15, "TTL": 60, "data": "20 mail2.example.com." } ] } },
    { "_label": "DoH NS", "match": { "host": "cloudflare-dns.com", "path": "/dns-query", "query": { "name": "example.com", "type": "NS" } },
      "json": { "Status": 0, "AD": true, "Answer": [ { "name": "example.com.", "type": 2, "TTL": 600, "data": "ns1.example.com." }, { "name": "example.com.", "type": 2, "TTL": 600, "data": "ns2.example.com." } ] } },
    { "_label": "DoH TXT: an SPF record and a record split in two quoted strings", "match": { "host": "cloudflare-dns.com", "path": "/dns-query", "query": { "name": "example.com", "type": "TXT" } },
      "json": { "Status": 0, "AD": true, "Answer": [ { "name": "example.com.", "type": 16, "TTL": 60, "data": "\"v=spf1 include:_spf.example.com ~all\"" }, { "name": "example.com.", "type": 16, "TTL": 60, "data": "\"hello\" \"world\"" } ] } },
    { "_label": "DoH SOA: the responsible mailbox (hostmaster.example.com.) must not appear in results", "match": { "host": "cloudflare-dns.com", "path": "/dns-query", "query": { "name": "example.com", "type": "SOA" } },
      "json": { "Status": 0, "AD": true, "Answer": [ { "name": "example.com.", "type": 6, "TTL": 300, "data": "ns1.example.com. hostmaster.example.com. 2024050101 7200 3600 1209600 300" } ] } },
    { "_label": "DoH CAA: one issue tag, one iodef mailto that must be withheld", "match": { "host": "cloudflare-dns.com", "path": "/dns-query", "query": { "name": "example.com", "type": "CAA" } },
      "json": { "Status": 0, "AD": true, "Answer": [ { "name": "example.com.", "type": 257, "TTL": 300, "data": "0 issue \"letsencrypt.org\"" }, { "name": "example.com.", "type": 257, "TTL": 300, "data": "0 iodef \"mailto:security@example.com\"" } ] } },
    { "_label": "DoH CNAME chain for www.example.com asked as A: a CNAME then an address", "match": { "host": "cloudflare-dns.com", "path": "/dns-query", "query": { "name": "www.example.com", "type": "A" } },
      "json": { "Status": 0, "AD": false, "Answer": [ { "name": "www.example.com.", "type": 5, "TTL": 120, "data": "edge.example.net." }, { "name": "edge.example.net.", "type": 1, "TTL": 120, "data": "198.51.100.9" } ] } },
    { "_label": "DoH NXDOMAIN (Status 3)", "match": { "host": "cloudflare-dns.com", "path": "/dns-query", "query": { "name": "missing.example.com", "type": "A" } }, "json": { "Status": 3, "AD": false } },
    { "_label": "Google resolver, A record", "match": { "host": "dns.google", "path": "/resolve", "query": { "name": "example.com", "type": "A" } },
      "json": { "Status": 0, "AD": false, "Answer": [ { "name": "example.com.", "type": 1, "TTL": 100, "data": "198.51.100.8" } ] } },

    { "_label": "crt.sh: 4 rows, one duplicate id; 1002 has a wildcard; 1003 lists an email (withheld) and a name of another domain (out of scope)", "match": { "host": "crt.sh", "path": "/", "query": { "q": "%.example.com", "output": "json" } },
      "json": [
        { "id": 1001, "issuer_ca_id": 1, "issuer_name": "C=XX, O=Fixture CA, CN=Fixture Issuing CA 1", "common_name": "example.com", "name_value": "example.com\nwww.example.com", "entry_timestamp": "2024-01-02T03:04:05.678", "not_before": "2024-01-01T00:00:00", "not_after": "2024-04-01T23:59:59", "serial_number": "0a1b2c" },
        { "id": 1002, "issuer_ca_id": 1, "issuer_name": "C=XX, O=Fixture CA, CN=Fixture Issuing CA 1", "common_name": "*.example.com", "name_value": "*.example.com\nexample.com", "entry_timestamp": "2024-06-02T03:04:05.678", "not_before": "2024-06-01T00:00:00", "not_after": "2024-09-01T23:59:59", "serial_number": "0d4e5f" },
        { "id": 1003, "issuer_ca_id": 2, "issuer_name": "C=XX, O=Fixture CA, CN=Fixture Issuing CA 2", "common_name": "api.example.com", "name_value": "api.example.com\nuser@example.com\nother-site.org", "entry_timestamp": "2025-01-02T03:04:05.678", "not_before": "2025-01-01T00:00:00", "not_after": "2025-04-01T23:59:59", "serial_number": "0aa0bb" },
        { "id": 1001, "issuer_ca_id": 1, "issuer_name": "C=XX, O=Fixture CA, CN=Fixture Issuing CA 1", "common_name": "example.com", "name_value": "example.com", "entry_timestamp": "2024-01-02T03:04:05.678", "not_before": "2024-01-01T00:00:00", "not_after": "2024-04-01T23:59:59", "serial_number": "0a1b2c" }
      ] },
    { "_label": "crt.sh with nothing logged answers an empty body", "match": { "host": "crt.sh", "path": "/", "query": { "q": "%.nothing.example.com" } }, "text": "" },
    { "_label": "crt.sh overloaded: 503 without Retry-After", "match": { "host": "crt.sh", "path": "/", "query": { "q": "%.busy.example.com" } }, "status": 503, "text": "Service Unavailable" },
    { "_label": "crt.sh throttling with Retry-After: 30", "match": { "host": "crt.sh", "path": "/", "query": { "q": "%.limited.example.com" } }, "status": 429, "headers": { "retry-after": "30" }, "text": "slow down" },

    { "_label": "CDX first capture (limit=1)", "match": { "host": "web.archive.org", "path": "/cdx/search/cdx", "query": { "url": "example.com", "limit": "1" } },
      "json": [ ["timestamp", "original", "statuscode", "mimetype", "digest"], ["19960101000000", "http://example.com/", "200", "text/html", "AAAA1111"] ] },
    { "_label": "CDX last capture (limit=-1)", "match": { "host": "web.archive.org", "path": "/cdx/search/cdx", "query": { "url": "example.com", "limit": "-1" } },
      "json": [ ["timestamp", "original", "statuscode", "mimetype", "digest"], ["20260301120000", "https://example.com/", "200", "text/html", "BBBB2222"] ] },
    { "_label": "CDX one capture per calendar year (collapse timestamp:4): captured in 1996, 2005, 2026", "match": { "host": "web.archive.org", "path": "/cdx/search/cdx", "query": { "url": "example.com", "collapse": "timestamp:4" } },
      "json": [ ["timestamp", "original"], ["19960101000000", "http://example.com/"], ["20050505050505", "http://example.com/"], ["20260301120000", "https://example.com/"] ] },
    { "_label": "CDX monthly list (collapse timestamp:6): three captures", "match": { "host": "web.archive.org", "path": "/cdx/search/cdx", "query": { "url": "example.com", "collapse": "timestamp:6" } },
      "json": [ ["timestamp", "original", "statuscode", "mimetype", "digest"], ["20200115010101", "https://example.com/", "200", "text/html", "C1"], ["20200220010101", "https://example.com/", "301", "text/html", "C2"], ["20200301010101", "https://example.com/about", "404", "text/html", "C3"] ] },
    { "_label": "CDX has nothing for this address (empty body)", "match": { "host": "web.archive.org", "path": "/cdx/search/cdx", "query": { "url": "nothing.example.net" } }, "text": "" },
    { "_label": "Wayback availability: nearest capture 2015-03-04", "match": { "host": "archive.org", "path": "/wayback/available", "query": { "url": "example.com" } },
      "json": { "url": "example.com", "archived_snapshots": { "closest": { "status": "200", "available": true, "url": "http://web.archive.org/web/20150304050607/http://example.com/", "timestamp": "20150304050607" } } } },
    { "_label": "Wayback availability: nothing", "match": { "host": "archive.org", "path": "/wayback/available", "query": { "url": "nothing.example.net" } }, "json": { "url": "nothing.example.net", "archived_snapshots": {} } },
    { "_label": "Wayback availability answering with an address on another host (must be refused)", "match": { "host": "archive.org", "path": "/wayback/available", "query": { "url": "evil.example.net" } },
      "json": { "archived_snapshots": { "closest": { "status": "200", "available": true, "url": "http://elsewhere.example.net/web/20150304050607/http://evil.example.net/", "timestamp": "20150304050607" } } } },

    { "_label": "GDELT article list: 3 rows (one duplicate address, one javascript: address that must be skipped)", "match": { "host": "api.gdeltproject.org", "path": "/api/v2/doc/doc", "query": { "mode": "artlist" } },
      "json": { "articles": [
        { "url": "https://news.example.org/a1", "title": "Fixture Corp opens new plant", "seendate": "20260310T091500Z", "domain": "news.example.org", "language": "English", "sourcecountry": "United Kingdom" },
        { "url": "https://news.example.org/a1", "title": "Fixture Corp opens new plant (duplicate)", "seendate": "20260310T091500Z", "domain": "news.example.org", "language": "English", "sourcecountry": "United Kingdom" },
        { "url": "javascript:alert(1)", "title": "not an address", "seendate": "20260310T091500Z" },
        { "url": "https://daily.example.net/b2", "title": "Plant opening delayed", "seendate": "20260311T101500Z", "domain": "daily.example.net", "language": "English", "sourcecountry": "Ireland" } ] } },
    { "_label": "GDELT volume timeline: two daily points", "match": { "host": "api.gdeltproject.org", "path": "/api/v2/doc/doc", "query": { "mode": "timelinevol" } },
      "json": { "timeline": [ { "series": "Volume Intensity", "data": [ { "date": "20260301T000000Z", "value": 0.012 }, { "date": "20260302T000000Z", "value": 0.034 } ] } ] } },

    { "_label": "Wikidata search 'Fixture Corp': three items", "match": { "host": "www.wikidata.org", "path": "/w/api.php", "query": { "action": "wbsearchentities", "search": "Fixture Corp" } },
      "json": { "search": [ { "id": "Q1001", "label": "Fixture Corp", "description": "fictional company" }, { "id": "Q1002", "label": "Fixture Corp", "description": "a person with this name" }, { "id": "Q1003", "label": "Fixture Corp Holdings", "description": "fictional holding company" } ] } },
    { "_label": "Wikidata search for the self-test name 'Mozilla Foundation': answered with the same fixture items", "match": { "host": "www.wikidata.org", "path": "/w/api.php", "query": { "action": "wbsearchentities", "search": "Mozilla Foundation" } },
      "json": { "search": [ { "id": "Q1001", "label": "Fixture Corp", "description": "fictional company" } ] } },
    { "_label": "Wikidata entities for the company search: Q1001 company with website and inception 1998; Q1002 is a human (P31 Q5, must be withheld); Q1003 company without website", "match": { "host": "www.wikidata.org", "path": "/w/api.php", "query": { "action": "wbgetentities", "ids": "Q1001|Q1002|Q1003" } },
      "json": { "entities": {
        "Q1001": { "id": "Q1001", "labels": { "en": { "value": "Fixture Corp" } }, "descriptions": { "en": { "value": "fictional company" } }, "claims": { "P31": [ { "mainsnak": { "datavalue": { "value": { "id": "Q4830453" } } } } ], "P856": [ { "mainsnak": { "datavalue": { "value": "https://www.fixture-corp.example/" } } } ], "P571": [ { "mainsnak": { "datavalue": { "value": { "time": "+1998-09-04T00:00:00Z", "precision": 11 } } } } ] } },
        "Q1002": { "id": "Q1002", "labels": { "en": { "value": "Fixture Corp" } }, "descriptions": { "en": { "value": "a person with this name" } }, "claims": { "P31": [ { "mainsnak": { "datavalue": { "value": { "id": "Q5" } } } } ] } },
        "Q1003": { "id": "Q1003", "labels": { "en": { "value": "Fixture Corp Holdings" } }, "descriptions": { "en": { "value": "fictional holding company" } }, "claims": { "P31": [ { "mainsnak": { "datavalue": { "value": { "id": "Q43229" } } } } ] } } } } },
    { "_label": "Wikidata entities for the self-test search (only Q1001)", "match": { "host": "www.wikidata.org", "path": "/w/api.php", "query": { "action": "wbgetentities", "ids": "Q1001" } },
      "json": { "entities": { "Q1001": { "id": "Q1001", "labels": { "en": { "value": "Fixture Corp" } }, "descriptions": { "en": { "value": "fictional company" } }, "claims": { "P31": [ { "mainsnak": { "datavalue": { "value": { "id": "Q4830453" } } } } ] } } } } },
    { "_label": "Wikidata search 'Fixtureville': one place with coordinates, one without", "match": { "host": "www.wikidata.org", "path": "/w/api.php", "query": { "action": "wbsearchentities", "search": "Fixtureville" } },
      "json": { "search": [ { "id": "Q2001", "label": "Fixtureville", "description": "fictional town" }, { "id": "Q2002", "label": "Fixtureville Township", "description": "fictional administrative area" } ] } },
    { "_label": "Wikidata entities for the places: Q2001 at 51.5, -0.12; Q2002 has no P625", "match": { "host": "www.wikidata.org", "path": "/w/api.php", "query": { "action": "wbgetentities", "ids": "Q2001|Q2002" } },
      "json": { "entities": {
        "Q2001": { "id": "Q2001", "labels": { "en": { "value": "Fixtureville" } }, "descriptions": { "en": { "value": "fictional town" } }, "claims": { "P31": [ { "mainsnak": { "datavalue": { "value": { "id": "Q3957" } } } } ], "P625": [ { "mainsnak": { "datavalue": { "value": { "latitude": 51.5, "longitude": -0.12 } } } } ] } },
        "Q2002": { "id": "Q2002", "labels": { "en": { "value": "Fixtureville Township" } }, "descriptions": { "en": { "value": "fictional administrative area" } }, "claims": { "P31": [ { "mainsnak": { "datavalue": { "value": { "id": "Q15284" } } } } ] } } } } },
    { "_label": "Wikidata search with no hits", "match": { "host": "www.wikidata.org", "path": "/w/api.php", "query": { "action": "wbsearchentities", "search": "Nothing Matches This" } }, "json": { "search": [] } }
  ]
}
