{
  "id": "zap-baseline",
  "name": "OWASP ZAP baseline scan",
  "version": "1.0.0",
  "description": "Crawls one host and applies ZAP passive rules with the OWASP ZAP program (needs Java). Baseline only: no attack scan, no fuzzing.",
  "capabilities": [
    "web-scan",
    "baseline"
  ],
  "scope": "active",
  "network": "keyless-external",
  "licence": {
    "spdx": "Apache-2.0",
    "url": "https://spdx.org/licenses/Apache-2.0.html",
    "mode": "separate-program"
  },
  "installRequirements": [
    {
      "name": "OWASP ZAP installed and unchanged",
      "check": [
        "@node",
        "run.js",
        "--check"
      ]
    },
    {
      "name": "Java 17 or newer",
      "check": [
        "@node",
        "run.js",
        "--check=java"
      ]
    }
  ],
  "command": {
    "executable": "@node",
    "args": [
      "run.js",
      "--action={action}",
      "--target={target}",
      "--scheme={scheme}",
      "--port={port}"
    ],
    "files": [
      "common.js",
      "tool.js"
    ]
  },
  "input": {
    "fields": [
      {
        "name": "action",
        "type": "enum",
        "label": "Mode",
        "required": false,
        "values": [
          "scan",
          "selftest"
        ]
      },
      {
        "name": "target",
        "type": "url-host",
        "label": "Target host"
      },
      {
        "name": "scheme",
        "type": "enum",
        "label": "Scheme",
        "required": false,
        "values": [
          "https",
          "http"
        ]
      },
      {
        "name": "port",
        "type": "integer",
        "label": "Port",
        "required": false,
        "min": 1,
        "max": 65535
      }
    ]
  },
  "output": {
    "format": "jsonl"
  },
  "limits": {
    "timeoutMs": 600000,
    "maxOutputBytes": 8388608,
    "maxConcurrent": 1
  },
  "permissions": [
    "network",
    "temp-files"
  ],
  "externalRestrictions": "ACTIVE: it sends traffic to the target. Only use it on systems you own or have written permission to test. Every run is recorded in the audit log on this computer, needs your confirmation each time, and is never routed through Tor or any proxy. The crawl is kept to the declared host. ZAP is a large Java program (many tens of MB) and is not part of Mayfair; it is downloaded only on your request. It is a separate program, not part of Mayfair: Ghost downloads it into its tools folder on first use (checksum verified, then tested) or you point Ghost at your own copy. It is shown as installed only after its own self-test passes.",
  "selfTest": {
    "input": {
      "action": "selftest",
      "target": "localhost"
    },
    "expect": {
      "minResults": 2,
      "contains": [
        {
          "type": "selftest",
          "value": "passed"
        }
      ]
    }
  }
}
