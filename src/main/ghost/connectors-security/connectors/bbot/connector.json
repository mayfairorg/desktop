{
  "id": "bbot",
  "name": "BBOT passive discovery",
  "version": "1.0.0",
  "description": "Passive asset discovery for a domain with BBOT: the subdomain-enum preset restricted to passive modules. The target is not contacted.",
  "capabilities": [
    "asset-discovery",
    "subdomain-discovery"
  ],
  "scope": "passive",
  "network": "rate-limited",
  "licence": {
    "spdx": "AGPL-3.0-only",
    "url": "https://spdx.org/licenses/AGPL-3.0-only.html",
    "mode": "separate-program"
  },
  "installRequirements": [
    {
      "name": "BBOT installed and unchanged",
      "check": [
        "@node",
        "run.js",
        "--check"
      ]
    },
    {
      "name": "Python 3 or newer",
      "check": [
        "@node",
        "run.js",
        "--check=python"
      ]
    }
  ],
  "command": {
    "executable": "@node",
    "args": [
      "run.js",
      "--action={action}",
      "--domain={domain}",
      "--preset={preset}"
    ],
    "files": [
      "common.js",
      "tool.js"
    ]
  },
  "input": {
    "fields": [
      {
        "name": "action",
        "type": "enum",
        "label": "Mode",
        "required": false,
        "values": [
          "scan",
          "selftest"
        ]
      },
      {
        "name": "domain",
        "type": "url-host",
        "label": "Domain"
      },
      {
        "name": "preset",
        "type": "enum",
        "label": "Preset",
        "required": false,
        "values": [
          "subdomain-enum"
        ]
      }
    ]
  },
  "output": {
    "format": "jsonl"
  },
  "limits": {
    "timeoutMs": 600000,
    "maxOutputBytes": 8388608,
    "maxConcurrent": 1
  },
  "permissions": [
    "network",
    "temp-files"
  ],
  "externalRestrictions": "BBOT is AGPL software: never bundled, run only as a separate program. Only modules flagged passive run; aggressive and deadly modules are excluded. Anything about individuals (email addresses, usernames, people, social profiles) is discarded by design; the tool is run with a fixed allowlist, so those modules cannot be selected. It is a separate program, not part of Mayfair: Ghost downloads it into its tools folder on first use (checksum verified, then tested) or you point Ghost at your own copy. It is shown as installed only after its own self-test passes.",
  "selfTest": {
    "input": {
      "action": "selftest",
      "domain": "example.com"
    },
    "expect": {
      "minResults": 2,
      "contains": [
        {
          "type": "selftest",
          "value": "passed"
        }
      ]
    }
  }
}
