{
  "id": "whatweb",
  "name": "WhatWeb site fingerprint",
  "version": "1.0.0",
  "description": "Identifies web technologies on one host with the WhatWeb program at its gentlest level (one request, no redirects followed).",
  "capabilities": [
    "web-fingerprint"
  ],
  "scope": "active",
  "network": "keyless-external",
  "licence": {
    "spdx": "GPL-2.0-only",
    "url": "https://spdx.org/licenses/GPL-2.0-only.html",
    "mode": "separate-program"
  },
  "installRequirements": [
    {
      "name": "WhatWeb installed and unchanged",
      "check": [
        "@node",
        "run.js",
        "--check"
      ]
    },
    {
      "name": "Ruby 2 or newer",
      "check": [
        "@node",
        "run.js",
        "--check=ruby"
      ]
    }
  ],
  "command": {
    "executable": "@node",
    "args": [
      "run.js",
      "--action={action}",
      "--target={target}",
      "--scheme={scheme}",
      "--port={port}"
    ],
    "files": [
      "common.js",
      "tool.js"
    ]
  },
  "input": {
    "fields": [
      {
        "name": "action",
        "type": "enum",
        "label": "Mode",
        "required": false,
        "values": [
          "scan",
          "selftest"
        ]
      },
      {
        "name": "target",
        "type": "url-host",
        "label": "Target host"
      },
      {
        "name": "scheme",
        "type": "enum",
        "label": "Scheme",
        "required": false,
        "values": [
          "https",
          "http"
        ]
      },
      {
        "name": "port",
        "type": "integer",
        "label": "Port",
        "required": false,
        "min": 1,
        "max": 65535
      }
    ]
  },
  "output": {
    "format": "jsonl"
  },
  "limits": {
    "timeoutMs": 120000,
    "maxOutputBytes": 8388608,
    "maxConcurrent": 1
  },
  "permissions": [
    "network",
    "temp-files"
  ],
  "externalRestrictions": "ACTIVE: it sends traffic to the target. Only use it on systems you own or have written permission to test. Every run is recorded in the audit log on this computer, needs your confirmation each time, and is never routed through Tor or any proxy. Page-scraped email addresses and author names are left out by design. WhatWeb is GPL software run as a separate program. It is a separate program, not part of Mayfair: Ghost downloads it into its tools folder on first use (checksum verified, then tested) or you point Ghost at your own copy. It is shown as installed only after its own self-test passes.",
  "selfTest": {
    "input": {
      "action": "selftest",
      "target": "localhost"
    },
    "expect": {
      "minResults": 2,
      "contains": [
        {
          "type": "selftest",
          "value": "passed"
        }
      ]
    }
  }
}
